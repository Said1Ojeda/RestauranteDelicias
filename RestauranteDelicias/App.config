<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
    <connectionStrings>
        <!-- cadena por defecto, cada compu la puede cambiar desde el boton Conexion y se guarda cifrada en AppData -->
        <add name="Restaurante"
             connectionString="Server=.\SQLEXPRESS;Database=RestauranteDelicias;Integrated Security=True;Connect Timeout=5;Application Name=RestauranteDelicias"
             providerName="System.Data.SqlClient" />
    </connectionStrings>
</configuration>
